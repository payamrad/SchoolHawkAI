AZURE_FOUNDRY_AGENT_ENDPOINT=https://SchoolHawkAIFoundry.services.ai.azure.com/api/projects/proj-default/agents/StudentGradesConsultant/endpoint/protocols/openai/responses
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=2025-11-15-preview
AZURE_FOUNDRY_TIMEOUT_MS=120000
# UTF-8 request-body limit, not a model token budget. Oversized input fails without truncation.
AZURE_FOUNDRY_MAX_REQUEST_BYTES=52428800

# Needed for unattended portal logins. Keep actual credentials only in private .env.
SKYWARD_USERNAME=
SKYWARD_PASSWORD=
CANVAS_USERNAME=
CANVAS_PASSWORD=

# Brevo transactional delivery. BREVIO_KEY is also accepted as a compatibility alias.
BREVO_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SchoolHawkAI
# Use your registered/approved SMS Sender ID; US delivery also needs toll-free approval.
BREVO_SMS_SENDER=
# Comma-separated private recipient lists. Empty lists disable that channel.
REPORT_EMAIL_RECIPIENTS=
REPORT_SMS_RECIPIENTS=
